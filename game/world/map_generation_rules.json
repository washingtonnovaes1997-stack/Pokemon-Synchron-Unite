{
  "version": 1,
  "design_goal": "Generate an entirely original Aurelis overworld without reusing Emerald city layouts.",
  "grid": {"tile_px": 16, "border": 2, "safe_edge": 3},
  "terrain_codes": {"grass": 1, "path": 2, "water": 3, "forest": 4, "rock": 5, "sand": 6, "snow": 7, "urban": 8, "hazard": 9, "landmark": 10},
  "city_archetypes": {
    "moonlit_meadow": {"ground":"grass","path":"path","water":true,"landmark":"lunar_observatory","pattern":"crescent"},
    "wind_plains": {"ground":"grass","path":"path","water":false,"landmark":"windmill_arc","pattern":"crosswind"},
    "deep_grove": {"ground":"grass","path":"path","water":true,"landmark":"elder_tree","pattern":"forest_ring"},
    "granite_hills": {"ground":"rock","path":"path","water":false,"landmark":"stone_gate","pattern":"terraces"},
    "ashlands": {"ground":"hazard","path":"rock","water":false,"landmark":"ember_forge","pattern":"caldera"},
    "coast": {"ground":"sand","path":"path","water":true,"landmark":"sea_lighthouse","pattern":"harbor"},
    "reef_coast": {"ground":"sand","path":"path","water":true,"landmark":"coral_tower","pattern":"islets"},
    "sun_fields": {"ground":"grass","path":"path","water":false,"landmark":"solar_garden","pattern":"sunburst"},
    "industrial": {"ground":"urban","path":"urban","water":true,"landmark":"gear_foundry","pattern":"grid"},
    "cloud_highlands": {"ground":"rock","path":"path","water":false,"landmark":"cloud_bridge","pattern":"ridge"},
    "storm_city": {"ground":"urban","path":"urban","water":true,"landmark":"storm_spire","pattern":"radial"},
    "flower_valley": {"ground":"grass","path":"path","water":true,"landmark":"bloom_plaza","pattern":"petals"},
    "twilight_forest": {"ground":"forest","path":"path","water":true,"landmark":"dusk_shrine","pattern":"spiral"},
    "crystal_caves": {"ground":"rock","path":"path","water":true,"landmark":"crystal_arch","pattern":"cavern"},
    "snowfield": {"ground":"snow","path":"path","water":true,"landmark":"ice_clock","pattern":"snowflake"},
    "red_canyon": {"ground":"rock","path":"sand","water":false,"landmark":"canyon_bridge","pattern":"switchback"},
    "dragon_cliffs": {"ground":"rock","path":"path","water":false,"landmark":"dragon_gate","pattern":"cliff_ring"},
    "lake_district": {"ground":"grass","path":"path","water":true,"landmark":"lake_pavilion","pattern":"canals"},
    "mirage_desert": {"ground":"sand","path":"sand","water":false,"landmark":"mirage_obelisk","pattern":"oasis_ring"},
    "astral_plateau": {"ground":"rock","path":"path","water":false,"landmark":"astral_array","pattern":"constellation"},
    "archipelago": {"ground":"sand","path":"path","water":true,"landmark":"tide_monument","pattern":"islands"},
    "toxic_marsh": {"ground":"forest","path":"path","water":true,"landmark":"purifier_tower","pattern":"boardwalk"},
    "sky_terraces": {"ground":"rock","path":"path","water":false,"landmark":"sky_garden","pattern":"terraces"},
    "metal_mines": {"ground":"rock","path":"urban","water":false,"landmark":"mine_lift","pattern":"rail_grid"},
    "ancient_forest": {"ground":"forest","path":"path","water":true,"landmark":"root_temple","pattern":"forest_ring"},
    "haunted_basin": {"ground":"forest","path":"path","water":true,"landmark":"echo_belfry","pattern":"spiral"},
    "dunes": {"ground":"sand","path":"sand","water":false,"landmark":"dune_compass","pattern":"oasis_ring"},
    "wind_spires": {"ground":"rock","path":"path","water":false,"landmark":"aero_spires","pattern":"ridge"},
    "scarlet_savanna": {"ground":"grass","path":"sand","water":true,"landmark":"scarlet_arena","pattern":"sunburst"},
    "neon_metropolis": {"ground":"urban","path":"urban","water":true,"landmark":"synchron_tower","pattern":"mega_grid"},
    "eclipse_valley": {"ground":"forest","path":"path","water":true,"landmark":"eclipse_gate","pattern":"crescent"},
    "ancient_ruins": {"ground":"sand","path":"rock","water":false,"landmark":"orichal_vault","pattern":"ruin_grid"},
    "star_summit": {"ground":"snow","path":"rock","water":false,"landmark":"celestial_observatory","pattern":"constellation"},
    "sacred_peak": {"ground":"rock","path":"rock","water":false,"landmark":"astral_crown","pattern":"summit"}
  },
  "city_feature_plan": {
    "required": ["player_walkable_core","pokemon_center","shop","landmark","residential_cluster","npc_plaza","route_gate","fly_point"],
    "gym_city_extra": ["gym_exterior","gym_approach","badge_gate"],
    "minimum_buildings": 5,
    "minimum_npc_slots": 8
  },
  "interior_templates": {
    "pokemon_center": {"size":[16,12],"rooms":["lobby","healing","pc","service"]},
    "shop": {"size":[14,10],"rooms":["sales","display","stock"]},
    "house_small": {"size":[12,10],"rooms":["living","sleep"]},
    "house_large": {"size":[16,12],"rooms":["living","sleep","study"]},
    "gym": {"size":[30,24],"rooms":["entry","puzzle","trainer_zone","leader"]},
    "story_building": {"size":[24,18],"rooms":["entry","story","service","backroom"]}
  },
  "route_rules": {"min_width":24,"min_height":18,"trainer_slots":6,"item_slots":4,"encounter_zones":3,"rest_points_every":4},
  "validation": ["no_disconnected_walkable_islands","all_warps_have_targets","all_city_entrances_reachable","landmark_reachable","required_buildings_present","no_emerald_layout_reference"]
}
